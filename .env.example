# ==========================================================================
# Пример файла настроек для бота MAX (max_polling_bot.py, версия 2)
#
# Как использовать:
# 1. Скопируйте этот файл и назовите копию ".env" (без .example).
#    Файл .env должен лежать рядом со скриптом max_polling_bot.py.
# 2. Заполните значения после знака "=" в файле .env.
# 3. Файл .env НЕ коммитьте в Git: он уже указан в .gitignore.
#
# Правила записи:
# - строки, начинающиеся с "#", — комментарии, на работу бота они не влияют;
# - без пробелов вокруг знака "=", без кавычек (кавычки допустимы, но не нужны);
# - если переменная задана в окружении Windows, она важнее значения из .env.
#
# Обязательные переменные: MAX_BOT_TOKEN, OWNER_ID, OPENROUTER_API_KEY, OPENROUTER_MODEL.
# Если хотя бы одна пуста, бот не запустится и покажет, какие не заданы.
# ==========================================================================


# --------------------------------------------------------------------------
# MAX_BOT_TOKEN (обязательно)
# Токен вашего бота в MAX. Выдаётся при создании бота в платформе для
# разработчиков MAX. С ним можно управлять ботом: не передавайте его никому.
# Если токен утёк, перевыпустите его в настройках бота и обновите .env.
# --------------------------------------------------------------------------
MAX_BOT_TOKEN=

# --------------------------------------------------------------------------
# OWNER_ID (обязательно)
# Числовой user_id вашего аккаунта в MAX. Команды управления принимаются
# только от него, остальные отправители получают ответ «только по приглашению».
# Число без кавычек и пробелов, не 0.
# Пример: 123456789
# --------------------------------------------------------------------------
OWNER_ID=

# --------------------------------------------------------------------------
# OPENROUTER_API_KEY (обязательно)
# Ключ API от OpenRouter, создаётся на https://openrouter.ai/keys.
# Начинается с "sk-or-". Если ключ попадал в чат, репозиторий или файл,
# который видел кто-то ещё, отзовите его и создайте новый.
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=

# --------------------------------------------------------------------------
# OPENROUTER_MODEL (обязательно)
# Модель OpenRouter в формате "провайдер/название". Модель обязана принимать
# изображения (input_modalities содержит "image"), иначе бот остановится при
# старте с сообщением об этом. Список: https://openrouter.ai/models (фильтр по image).
# Пример: openai/gpt-4o
# --------------------------------------------------------------------------
OPENROUTER_MODEL=

# --------------------------------------------------------------------------
# OPENROUTER_MAX_TOKENS (необязательно)
# Максимум токенов в ответе нейросети. По умолчанию 8192. Если ответ приходит
# обрезанным (в журнале: «ответ обрезан по лимиту max_tokens»), увеличьте.
# Диапазон: от 1 до 128000.
# --------------------------------------------------------------------------
# OPENROUTER_MAX_TOKENS=8192

# --------------------------------------------------------------------------
# MAX_BOT_NAME (рекомендуется)
# Имя бота в MAX без символа @. Нужно, чтобы ссылки-приглашения выглядели так:
# https://max.ru/<имя>?start=...
# Если не задано, ссылки будут без адреса бота, и бот выведет предупреждение.
# Пример: my_pvz_bot
# --------------------------------------------------------------------------
MAX_BOT_NAME=

# --------------------------------------------------------------------------
# DB_PATH (необязательно)
# Файл базы данных SQLite: получатели, архив, настройки, очередь событий.
# Если пусто, используется max_bot.sqlite3 в папке со скриптом.
# Пример: C:\Users\пользователь\Desktop\max_bot\data\max_bot.sqlite3
# (Если папки data нет, создайте её заранее; сам файл создастся автоматически.)
# --------------------------------------------------------------------------
# DB_PATH=

# --------------------------------------------------------------------------
# SAVE_DIR (необязательно)
# Папка, куда сохраняются присланные изображения.
# По умолчанию: incoming_images рядом со скриптом.
# --------------------------------------------------------------------------
# SAVE_DIR=

# --------------------------------------------------------------------------
# MAX_IMAGE_BYTES (необязательно)
# Максимальный размер картинки в байтах. По умолчанию 10485760 (10 МБ).
# Диапазон: от 1024 до 1073741824.
# --------------------------------------------------------------------------
# MAX_IMAGE_BYTES=10485760

# --------------------------------------------------------------------------
# ARCHIVE_DAYS (необязательно)
# Сколько дней хранить архив результатов и картинки. По умолчанию 30.
# Диапазон: от 1 до 36500.
# --------------------------------------------------------------------------
# ARCHIVE_DAYS=30

# --------------------------------------------------------------------------
# BOT_TZ (необязательно)
# Часовой пояс для дат в сообщениях и поиска по архиву.
# По умолчанию Europe/Moscow. На Windows для работы нужен пакет tzdata
# (pip install tzdata).
# --------------------------------------------------------------------------
# BOT_TZ=Europe/Moscow

# --------------------------------------------------------------------------
# INVITE_TTL_HOURS (необязательно)
# Срок действия персональной ссылки-приглашения в часах. По умолчанию 72.
# Диапазон: от 1 до 720.
# --------------------------------------------------------------------------
# INVITE_TTL_HOURS=72

# --------------------------------------------------------------------------
# MAX_UNSUBSCRIBE_WEBHOOK (необязательно)
# Если у бота включён webhook, long polling не получает события. Значение 1
# разрешает скрипту автоматически снять подписку webhook при запуске.
# Внимание: после этого webhook перестанет работать. По умолчанию 0 (выключено).
# --------------------------------------------------------------------------
# MAX_UNSUBSCRIBE_WEBHOOK=0

# --------------------------------------------------------------------------
# LOG_LEVEL (необязательно)
# Подробность журнала: DEBUG, INFO, WARNING, ERROR или CRITICAL.
# DEBUG — максимум деталей для отладки, INFO — обычная работа.
# По умолчанию INFO.
# --------------------------------------------------------------------------
# LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# LOG_DIR (необязательно)
# Папка журналов. Каждый запуск пишет файл bot_ДАТА_ВРЕМЯ.log.
# По умолчанию logs рядом со скриптом.
# --------------------------------------------------------------------------
# LOG_DIR=

# --------------------------------------------------------------------------
# LOG_KEEP_RUNS (необязательно)
# Сколько последних запусков хранить в LOG_DIR. По умолчанию 10.
# --------------------------------------------------------------------------
# LOG_KEEP_RUNS=10

# --------------------------------------------------------------------------
# OPENROUTER_REFERER и OPENROUTER_TITLE (необязательно)
# Подписи запроса для OpenRouter. Можно не менять.
# По умолчанию: http://localhost и MAX Image Bot.
# --------------------------------------------------------------------------
# OPENROUTER_REFERER=http://localhost
# OPENROUTER_TITLE=MAX Image Bot

# --------------------------------------------------------------------------
# POLL_TIMEOUT и POLL_LIMIT (необязательно)
# Настройки опроса MAX. POLL_TIMEOUT — секунды ожидания (0–90, по умолчанию 30).
# POLL_LIMIT — максимум событий за один запрос (1–1000, по умолчанию 100).
# Менять не нужно, пока бот работает.
# --------------------------------------------------------------------------
# POLL_TIMEOUT=30
# POLL_LIMIT=100
